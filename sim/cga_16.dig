        </entry>
        <entry>
          <string>NetName</string>
          <string>MA_BUS</string>
        </entry>
      </elementAttributes>
      <pos x="1920" y="860"/>
    </visualElement>
    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>17</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>The CRTC is responsible for producing character cell and row scan
addresses based on the geometry programmed into its registers.
It is clocked at the &quot;character clock&quot; which is adjusted based on video
mode.</string>
        </entry>
      </elementAttributes>
      <pos x="1520" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes>
        <entry>
          <string>rotation</string>
          <rotation rotation="1"/>
        </entry>
