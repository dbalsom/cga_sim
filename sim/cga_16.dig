      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>17</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>This flip-flop latches the RGBI output of the color multiplexers
at the native 14MHz clock. 

Its secondary role is to produce the ~RESET signal from the 
~RESET&apos; input, delayed by one clock.</string>
        </entry>
      </elementAttributes>
      <pos x="880" y="2100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes>
        <entry>
          <string>rotation</string>
