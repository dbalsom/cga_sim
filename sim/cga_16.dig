      <elementAttributes>
        <entry>
          <string>textFontSize</string>
          <int>64</int>
        </entry>
        <entry>
          <string>Description</string>
          <string>The IBM Color Graphics Adapter</string>
        </entry>
      </elementAttributes>
      <pos x="2420" y="2440"/>
    </visualElement>
