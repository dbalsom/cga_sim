          <string>RectHeight</string>
          <int>36</int>
        </entry>
        <entry>
          <string>RectInside</string>
          <boolean>true</boolean>
        </entry>
        <entry>
          <string>Label</string>
          <string>U101: Color / Reset Latch</string>
